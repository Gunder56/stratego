@startuml class 
package "STRATEGO"{
abstract Units {
    - valeur : Grade
    + deplace() : void
}

enum Grade {
    MARECHAL = 10;
    GENERAL = 9;
    COLONEL = 8;
    COMMANDANT = 7;
    CAPITAINE = 6;
    LIEUTENANT = 5;
    SERGENT = 4;
    DEMINEUR = 3;
    ECLAIREUR = 2; 
    ESPION = 1; 
    FLAG = 0;
    BOMB = 11;

    - code : int
    + getCode() : code
    + 
}

class Fight {
    - fighter1 : Units;
    - fighter2 : Units;
    + fighting(fighter1, fighter2) : Units 
}

class Player {

}

class Game {
    - PlayerList[] : Player
    + initPlateau(player : Player) : void
}

interface Mode {

}

class BeginnerMode {

}

class ClassicMode {

}

class Timer {

}

class Cell {
    + estLibre(): boolean 
}

class Grid {
    - grid[][] : Cell
    + Grid()
    + Grid(longueur : int, largeur : int)
    + Grid(grid[][])
}
}

Units <-- Fight

Game <.. Timer
Game --> Mode
Game --o Player
BeginnerMode .up.|> Mode  
ClassicMode .up.|> Mode

Grid -- Cell

Grade --|> Units

@enduml

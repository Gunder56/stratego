@startuml class 
package "STRATEGO"{
abstract Units {
    - valeur : Grade
    + deplace(cell : Cell) : void
}

enum Grade {
    MARECHAL = 10;
    GENERAL = 9;
    COLONEL = 8;
    COMMANDANT = 7;
    CAPITAINE = 6;
    LIEUTENANT = 5;
    SERGENT = 4;
    DEMINEUR = 3;
    ECLAIREUR = 2; 
    ESPION = 1; 
    FLAG = 0;
    BOMB = 11;

    - code : int
    + Grade(code)
    + getCode() : code
    + {static} fromCode(code) : Grade
}

class Fight {
    - fighter1 : Units;
    - fighter2 : Units;
    + fighting(fighter1, fighter2) : Units 
}

abstract Player {
    - pieces[40] : Units
    + giveUp() : void
    + jouer(piece : Units, cell : Cell)
}

class RealPlayer{

}

class AIPlayer{

}

class Game {
    - PlayerList[] : Player
    + initPlateau(player : Player) : void
    + play(mode : Mode) : void 

}

interface Mode {

}

class BeginnerMode {

}

class ClassicMode {

}

class Timer {
}

class Cell {
    - storageUnits : Units
    + estLibre(): boolean 
}

class Grid {
    - grid[][] : Cell
    + Grid()
    + Grid(longueur : int, largeur : int)
    + Grid(grid[][])
    + update() : void
}
}

Units <-- Fight

Units <.. Cell
Game <.. Timer
Game ..> Mode
Game --o Player
BeginnerMode .up.|> Mode  
ClassicMode .up.|> Mode

Grid -- Cell

Grade --|> Units

Player --* Units
RealPlayer -up-|> Player
AIPlayer -up-|> Player


@enduml
